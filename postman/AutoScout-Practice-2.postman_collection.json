            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Foo\",\n  \"surname\": \"Bar\",\n  \"birthdate\": \"1990-01-01\",\n  \"address\": \"Street name\",\n  \"email\": \"seminar-2-test-{{$timestamp}}@example.com\",\n  \"password\": \"1234\"\n}"
            }

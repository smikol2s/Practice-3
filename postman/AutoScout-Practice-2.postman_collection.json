      "name": "0. Setup (IDs and public endpoints)",
      "item": [
        {
          "name": "GET products (public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const p = pm.response.json().products; pm.collectionVariables.set('productId', p[0]._id); pm.collectionVariables.set('productId2', p[1]._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            }
          }
        },
        {
          "name": "POST new user (public, password hashed)",
          "event": [
            {
              "listen": "test",
              "script": {
